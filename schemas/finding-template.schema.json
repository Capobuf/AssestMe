{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assestme.local/schemas/finding-template-v1.schema.json",
  "title": "AssestMe finding template library v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "templates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "externalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "nullableLongText": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "title",
        "category",
        "problem",
        "entrepreneur_notes",
        "technical_notes",
        "default_scope_type",
        "default_scope_description",
        "consequence",
        "likelihood",
        "priority",
        "priority_rationale",
        "active",
        "solutions"
      ],
      "properties": {
        "external_id": {
          "$ref": "#/$defs/externalId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "entrepreneur_notes": {
          "$ref": "#/$defs/nullableLongText"
        },
        "technical_notes": {
          "$ref": "#/$defs/nullableLongText"
        },
        "default_scope_type": {
          "enum": [
            "organization",
            "selected_sites",
            "network",
            "selected_assets",
            "custom"
          ]
        },
        "default_scope_description": {
          "$ref": "#/$defs/nullableLongText"
        },
        "consequence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "limited",
            "significant",
            "serious",
            "critical",
            null
          ]
        },
        "likelihood": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unlikely",
            "possible",
            "likely",
            "current",
            null
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            null
          ]
        },
        "priority_rationale": {
          "$ref": "#/$defs/nullableLongText"
        },
        "active": {
          "type": "boolean"
        },
        "solutions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/solution"
          },
          "contains": {
            "type": "object",
            "required": [
              "recommended"
            ],
            "properties": {
              "recommended": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "title",
        "description",
        "comparison_notes",
        "effort",
        "effort_notes",
        "estimate_type",
        "amount_min",
        "amount_max",
        "currency_code",
        "billing_frequency",
        "custom_billing_frequency",
        "estimate_notes",
        "recommended",
        "sort_order"
      ],
      "properties": {
        "external_id": {
          "$ref": "#/$defs/externalId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "comparison_notes": {
          "$ref": "#/$defs/nullableLongText"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "moderate",
            "high",
            "very_high",
            null
          ]
        },
        "effort_notes": {
          "$ref": "#/$defs/nullableLongText"
        },
        "estimate_type": {
          "enum": [
            "exact",
            "range",
            "bundled",
            "requires_quote",
            "requires_analysis",
            "variable",
            "not_applicable"
          ]
        },
        "amount_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 999999999.99,
          "multipleOf": 0.01
        },
        "amount_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 999999999.99,
          "multipleOf": 0.01
        },
        "currency_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "billing_frequency": {
          "enum": [
            "one_off",
            "monthly",
            "yearly",
            "custom"
          ]
        },
        "custom_billing_frequency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "estimate_notes": {
          "$ref": "#/$defs/nullableLongText"
        },
        "recommended": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estimate_type": {
                "const": "exact"
              }
            }
          },
          "then": {
            "properties": {
              "amount_min": {
                "type": "number"
              },
              "amount_max": {
                "type": "null"
              },
              "currency_code": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimate_type": {
                "const": "range"
              }
            }
          },
          "then": {
            "properties": {
              "amount_min": {
                "type": "number"
              },
              "amount_max": {
                "type": "number"
              },
              "currency_code": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimate_type": {
                "enum": [
                  "bundled",
                  "requires_quote",
                  "requires_analysis",
                  "variable",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "amount_min": {
                "type": "null"
              },
              "amount_max": {
                "type": "null"
              },
              "currency_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_frequency": {
                "const": "custom"
              }
            }
          },
          "then": {
            "properties": {
              "custom_billing_frequency": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "else": {
            "properties": {
              "custom_billing_frequency": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
