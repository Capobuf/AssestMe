<?php

// Merge the returned values into config/laravel-pdf.php after publishing the
// package configuration with `php artisan vendor:publish --tag=pdf-config`.
return [
    'driver' => env('LARAVEL_PDF_DRIVER', 'weasyprint'),

    'weasyprint' => [
        'binary' => env('LARAVEL_PDF_WEASYPRINT_BINARY', '/usr/bin/weasyprint'),
        'timeout' => null,
    ],
];
