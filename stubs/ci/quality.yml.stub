name: Quality

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    env:
      APP_ENV: testing
      APP_KEY: base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      APP_URL: http://127.0.0.1:8000
      CACHE_STORE: file
      SESSION_DRIVER: file
      QUEUE_CONNECTION: sync
      LARAVEL_PDF_DRIVER: dompdf

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          coverage: none
          extensions: bcmath, curl, dom, fileinfo, gd, intl, mbstring, pdo_sqlite, sqlite3, xml, zip
          tools: composer:v2

      - name: Validate and install locked dependencies
        run: |
          composer validate --strict
          composer install --no-interaction --prefer-dist --no-progress
          composer audit --locked --no-interaction

      - name: Prepare application assets
        run: |
          php artisan filament:assets

      - name: Run isolated quality gates
        run: RUN_DUSK=0 scripts/verify.sh

      - name: Detect ChromeDriver version
        run: php artisan dusk:chrome-driver --detect

      - name: Run isolated Dusk suite
        run: scripts/dusk-isolated.sh

      - name: Upload failure artifacts
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: assestme-failure-artifacts
          path: |
            storage/logs/*.log
            tests/Browser/screenshots
            tests/Browser/console
          if-no-files-found: ignore

  clean-bootstrap:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      DEV_ADMIN_NAME: CI Administrator
      DEV_ADMIN_EMAIL: admin@assestme.local
      DEV_ADMIN_PASSWORD: CI-Only!AssestMe-2026

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          coverage: none
          extensions: bcmath, curl, dom, fileinfo, gd, intl, mbstring, pdo_sqlite, sqlite3, xml, zip
          ini-values: memory_limit=512M
          tools: composer:v2

      - name: Install clean-bootstrap system tools
        run: sudo apt-get update && sudo apt-get install -y lsb-release sqlite3

      - name: Bootstrap a clean checkout
        run: scripts/bootstrap-local.sh "${GITHUB_WORKSPACE}"

      - name: Verify bootstrapped application
        run: |
          php artisan assestme:diagnose
          test "$(php artisan tinker --execute='echo App\Models\User::query()->count();')" = "1"
          test "$(php artisan tinker --execute='echo App\Models\Category::query()->count();')" = "18"
          test "$(php artisan tinker --execute='echo App\Models\Assessment::query()->count();')" = "0"
          test "$(php artisan tinker --execute='echo App\Models\FindingTemplate::query()->count();')" -gt "0"
