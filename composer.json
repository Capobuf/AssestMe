{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "assestme/assestme",
    "type": "project",
    "description": "Single-user IT assessment application for small and medium-sized organizations.",
    "keywords": [
        "assessment",
        "filament",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "leek/filament-right-click": "^1.3",
        "occtherapist/advanced-table-export-for-filament": "^1.0",
        "opis/json-schema": "^2.6",
        "phpoffice/phpspreadsheet": "^5.0",
        "pontedilana/php-weasyprint": "^2.7",
        "spatie/laravel-pdf": "^2.0"
    },
    "require-dev": {
        "baspa/filament-canary": "^1.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.0",
        "laravel/dusk": "^8.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12",
        "smalot/pdfparser": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "quality": [
            "bash scripts/quality-isolated.sh"
        ],
        "browser": [
            "bash scripts/dusk-isolated.sh"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "serve": [
            "@php artisan serve --host=127.0.0.1 --port=8000"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
