APP_NAME=AssestMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_TIMEZONE=Europe/Rome

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/AssestMe/database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE

# MySQL or MariaDB fresh installations use these values instead of the
# SQLite-specific settings above. Select exactly mysql or mariadb.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=assestme
# DB_USERNAME=assestme
# DB_PASSWORD=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LARAVEL_PDF_DRIVER=weasyprint
LARAVEL_PDF_WEASYPRINT_BINARY=/usr/bin/weasyprint

ASSESTME_PHP_BINARY=
ASSESTME_DB_DUMP_BINARY=
ASSESTME_DB_RESTORE_BINARY=

DEV_ADMIN_NAME=Administrator
DEV_ADMIN_EMAIL=admin@assestme.local
DEV_ADMIN_PASSWORD=

# Required only for production deployment.
ASSESTME_HOSTNAME=
ASSESTME_RELEASE_ROOT=
ASSESTME_BACKUP_ROOT=
ASSESTME_RUNTIME_GROUP=
ASSESTME_FPM_SERVICE=
ASSESTME_VERSION=development
