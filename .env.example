APP_NAME=AssestMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_TIMEZONE=Europe/Rome

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/AssestMe/database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LARAVEL_PDF_DRIVER=dompdf
LARAVEL_PDF_DOMPDF_REMOTE_ENABLED=false
LARAVEL_PDF_DOMPDF_CHROOT=/absolute/path/to/AssestMe

DEV_ADMIN_NAME=Administrator
DEV_ADMIN_EMAIL=admin@assestme.local
DEV_ADMIN_PASSWORD=

# Required only for production deployment.
ASSESTME_HOSTNAME=
ASSESTME_DEPLOY_USER=assestme
ASSESTME_RELEASE_ROOT=/var/www/assestme
ASSESTME_BACKUP_ROOT=/var/backups/assestme
ASSESTME_VERSION=development
